# Copy this file to .env and fill in the keys you have. All are free.
# Without any key the app still works with Arbeitnow, Remotive and Himalayas.

PORT=3000

# Adzuna — big aggregator (includes many Indeed / company-site offers), France supported.
# Free key: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr

# France Travail (ex Pôle emploi) — all French offers incl. CDI, CDD, intérim, saisonnier, alternance.
# Free key: https://francetravail.io/  -> create an app -> subscribe to "Offres d'emploi v2"
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Jooble — aggregator covering many job boards. Free key: https://jooble.org/api/about
JOOBLE_API_KEY=
